# =============================================================================
# 10. ФУНКЦИЯ ПЕРЕРАСПРЕДЕЛЕНИЯ НА ОСНОВЕ PRE/POST
# =============================================================================
def analyze_redistribution(redist_data):
    """
    Анализирует эффект перераспределения (налоги + трансферты)
    """
    # Годы с данными pre/post
    available_years = sorted(redist_data['year'].unique())
    
    fig, axes = plt.subplots(2, 3, figsize=(15, 10))
    
    # 1. Сравнение pre и post для последнего года
    latest_year = available_years[-1]
    data = redist_data[redist_data['year'] == latest_year].iloc[0]
    
    deciles = np.arange(1, 11)
    post_shares = []
    pre_shares = []
    
    for i in range(10):
        if i < 5:
            post_col = f'p{i}0p{i+1}0_post'
            pre_col = f'p{i}0p{i+1}0_pre' if i < 4 else 'p40p50_pre'
        else:
            if i == 5:
                post_col = 'p50p60_post'
                pre_col = 'p50p60_pre'
            elif i == 6:
                post_col = 'p60p70_post'
                pre_col = 'p60p70_pre'
            elif i == 7:
                post_col = 'p70p80_post'
                pre_col = 'p70p80_pre'
            elif i == 8:
                post_col = 'p80p90_post'
                pre_col = 'p80p90_pre'
            else:
                post_col = 'p90p100_post'
                pre_col = 'p90p100_pre'
        
        post_shares.append(data[post_col])
        pre_shares.append(data[pre_col])
    
    post_shares = np.array(post_shares)
    pre_shares = np.array(pre_shares)
    
    # Нормируем
    post_shares = post_shares / post_shares.sum()
    pre_shares = pre_shares / pre_shares.sum()
    
    ax = axes[0, 0]
    width = 0.35
    x = np.arange(len(deciles))
    ax.bar(x - width/2, pre_shares, width, label='До налогов', alpha=0.7, color='red')
    ax.bar(x + width/2, post_shares, width, label='После налогов', alpha=0.7, color='blue')
    ax.set_xlabel('Дециль')
    ax.set_ylabel('Доля дохода')
    ax.set_title(f'Распределение дохода ({latest_year})')
    ax.set_xticks(x)
    ax.set_xticklabels([f'D{i}' for i in range(1, 11)])
    ax.legend()
    ax.grid(True, alpha=0.3)
    
    # 2. Изменение доли по децилям (post - pre)
    ax = axes[0, 1]
    changes = (post_shares - pre_shares) * 100  # в процентных пунктах
    colors = ['green' if c > 0 else 'red' for c in changes]
    ax.bar(deciles, changes, color=colors, alpha=0.7)
    ax.axhline(y=0, color='black', linestyle='-', linewidth=0.5)
    ax.set_xlabel('Дециль')
    ax.set_ylabel('Изменение доли (п.п.)')
    ax.set_title('Эффект перераспределения')
    ax.grid(True, alpha=0.3)
    
    # 3. Динамика доли нижних 50%
    ax = axes[0, 2]
    years = []
    bottom50_pre = []
    bottom50_post = []
    
    for year in available_years:
        data = redist_data[redist_data['year'] == year].iloc[0]
        pre_sum = 0
        post_sum = 0
        for i in range(5):
            if i < 4:
                pre_col = f'p{i}0p{i+1}0_pre'
            else:
                pre_col = 'p40p50_pre'
            post_col = f'p{i}0p{i+1}0_post'
            pre_sum += data[pre_col]
            post_sum += data[post_col]
        
        years.append(year)
        bottom50_pre.append(pre_sum)
        bottom50_post.append(post_sum)
    
    bottom50_pre = np.array(bottom50_pre)
    bottom50_post = np.array(bottom50_post)
    
    # Нормируем к базовому году
    base_year = years[0]
    base_pre = bottom50_pre[0]
    base_post = bottom50_post[0]
    
    ax.plot(years, bottom50_pre/base_pre, 'o-', label='До налогов', color='red')
    ax.plot(years, bottom50_post/base_post, 'o-', label='После налогов', color='blue')
    ax.set_xlabel('Год')
    ax.set_ylabel('Относительная доля')
    ax.set_title('Динамика доли нижних 50%')
    ax.legend()
    ax.grid(True, alpha=0.3)
    
    # 4. Динамика доли верхних 10%
    ax = axes[1, 0]
    top10_pre = []
    top10_post = []
    
    for year in available_years:
        data = redist_data[redist_data['year'] == year].iloc[0]
        top10_pre.append(data['p90p100_pre'])
        top10_post.append(data['p90p100_post'])
    
    top10_pre = np.array(top10_pre)
    top10_post = np.array(top10_post)
    
    base_pre = top10_pre[0]
    base_post = top10_post[0]
    
    ax.plot(years, top10_pre/base_pre, 'o-', label='До налогов', color='red')
    ax.plot(years, top10_post/base_post, 'o-', label='После налогов', color='blue')
    ax.set_xlabel('Год')
    ax.set_ylabel('Относительная доля')
    ax.set_title('Динамика доли верхних 10%')
    ax.legend()
    ax.grid(True, alpha=0.3)
    
    # 5. Коэффициент перераспределения
    ax = axes[1, 1]
    redist_ratio = []
    
    for year in available_years:
        data = redist_data[redist_data['year'] == year].iloc[0]
        
        # Доля нижних 50% после / до
        bottom_pre = sum(data[f'p{i}0p{i+1}0_pre'] if i < 4 else data['p40p50_pre'] for i in range(5))
        bottom_post = sum(data[f'p{i}0p{i+1}0_post'] for i in range(5))
        
        # Доля верхних 10% после / до
        top_pre = data['p90p100_pre']
        top_post = data['p90p100_post']
        
        # Коэффициент перераспределения
        ratio = (bottom_post / bottom_pre) / (top_post / top_pre)
        redist_ratio.append(ratio)
    
    ax.plot(years, redist_ratio, 'o-', color='purple', linewidth=2)
    ax.axhline(y=1, color='gray', linestyle='--', alpha=0.5)
    ax.set_xlabel('Год')
    ax.set_ylabel('Коэффициент перераспределения')
    ax.set_title('Эффективность перераспределения')
    ax.grid(True, alpha=0.3)
    
    # 6. Функция ψ₀(γ)
    ax = axes[1, 2]
    psi0_func = build_psi0_function(redist_data, latest_year)
    gamma_plot = np.linspace(0.01, 0.2, 100)
    psi_plot = psi0_func(gamma_plot)
    # Нормируем для наглядности
    if psi_plot.sum() > 0:
        psi_plot = psi_plot / np.trapz(psi_plot, gamma_plot)
    ax.plot(gamma_plot, psi_plot, 'b-', linewidth=2)
    ax.set_xlabel('γ (доля дохода)')
    ax.set_ylabel('ψ₀(γ)')
    ax.set_title('Функция перераспределения')
    ax.grid(True, alpha=0.3)
    
    plt.tight_layout()
    plt.savefig('redistribution_analysis.png', dpi=150)
    plt.show()
    
    # Выводим статистику
    print(f"\nСтатистика перераспределения за {latest_year}:")
    print(f"  Доля нижних 50% до налогов: {bottom50_pre[-1]:.1f} €")
    print(f"  Доля нижних 50% после налогов: {bottom50_post[-1]:.1f} €")
    print(f"  Доля верхних 10% до налогов: {top10_pre[-1]:.1f} €")
    print(f"  Доля верхних 10% после налогов: {top10_post[-1]:.1f} €")
    print(f"  Коэффициент перераспределения: {redist_ratio[-1]:.3f}")

