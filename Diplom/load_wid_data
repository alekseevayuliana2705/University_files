# 9. СТАТИСТИКА
# ============================================

print("\n" + "="*60)
print("СТАТИСТИКА ПО СТРАНАМ")
print("="*60)

stats = []

for country in sorted(final_df['country'].unique()):
    country_data = final_df[final_df['country'] == country]
    years = sorted(country_data['year'].unique())
    
    if len(years) > 0:
        last_year = years[-1]
        year_data = country_data[country_data['year'] == last_year].sort_values('decile')
        
        if len(year_data) == 10:
            # Упрощённый коэффициент Джини
            pop = np.array([0.0] + list(np.arange(0.1, 1.01, 0.1)))
            inc_cum = np.array([0.0] + list(year_data['income_share'].cumsum().values))
            
            # Площадь под кривой Лоренца (метод трапеций)
            area_under_lorenz = np.trapz(inc_cum, pop)
            gini = 1 - 2 * area_under_lorenz
            
            stats.append({
                'country': country,
                'last_year': last_year,
                'gini': gini,
                'top10_share': year_data[year_data['decile'] == 10]['income_share'].values[0],
                'bottom50_share': year_data[year_data['decile'] <= 5]['income_share'].sum(),
                'n_years': len(years)
            })

stats_df = pd.DataFrame(stats)
stats_df = stats_df.sort_values('gini', ascending=False)

print("\nСтраны по уровню неравенства (Джини):")
print(stats_df.to_string(index=False))

