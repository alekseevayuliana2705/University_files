# 2. ФУНКЦИЯ ДЛЯ ЗАГРУЗКИ ФАЙЛА СТРАНЫ
# ============================================

def load_wid_file(file_path, country_name):
    """
    Загружает WID файл с разделителем ';' и извлекает данные
    """
    try:
        # Читаем файл, пропуская первую строку с описанием
        df = pd.read_csv(file_path, sep=';', encoding='utf-8', skiprows=1)
        
        # Переименовываем колонки для удобства
        df.columns = ['percentile', 'year', 'value']
        
        # Удаляем строки с пустыми значениями
        df = df.dropna(subset=['value'])
        
        # Преобразуем год и значение в числа
        df['year'] = pd.to_numeric(df['year'], errors='coerce')
        df['value'] = pd.to_numeric(df['value'], errors='coerce')
        
        # Удаляем строки с NaN
        df = df.dropna()
        
        print(f"   Загружено {len(df)} строк с данными")
        
        # Извлекаем нужные процентили
        bottom_50 = df[df['percentile'] == 'p0p50'].copy()
        top_10 = df[df['percentile'] == 'p90p100'].copy()
        top_1 = df[df['percentile'] == 'p99p100'].copy()
        
        print(f"   Найдено Bottom 50%: {len(bottom_50)} записей")
        print(f"   Найдено Top 10%: {len(top_10)} записей")
        print(f"   Найдено Top 1%: {len(top_1)} записей")
        
        if len(bottom_50) == 0 or len(top_10) == 0:
            print(f"   ❌ Не найдены нужные показатели")
            return None
        
        # Создаем словарь для объединения по годам
        data_by_year = {}
        
        # Добавляем Bottom 50%
        for _, row in bottom_50.iterrows():
            year = int(row['year'])
            if year not in data_by_year:
                data_by_year[year] = {}
            data_by_year[year]['bottom_50'] = row['value']
        
        # Добавляем Top 10%
        for _, row in top_10.iterrows():
            year = int(row['year'])
            if year not in data_by_year:
                data_by_year[year] = {}
            data_by_year[year]['top_10'] = row['value']
        
        # Добавляем Top 1% (если есть)
        for _, row in top_1.iterrows():
            year = int(row['year'])
            if year not in data_by_year:
                data_by_year[year] = {}
            data_by_year[year]['top_1'] = row['value']
        
        # Преобразуем в DataFrame
        result = []
        for year, values in sorted(data_by_year.items()):
            if 'bottom_50' in values and 'top_10' in values:
                # Значения уже в долях (не в процентах)
                result.append({
                    'year': year,
                    'bottom_50': values['bottom_50'],
                    'top_10': values['top_10'],
                    'top_1': values.get('top_1', np.nan)
                })
        
        df_result = pd.DataFrame(result)
        print(f"   ✅ Получено {len(df_result)} лет с полными данными")
        
        return df_result
        
    except Exception as e:
        print(f"   ❌ Ошибка при загрузке: {e}")
        return None

# ============================================
# 3. ФУНКЦИЯ ДЛЯ ПРЕОБРАЗОВАНИЯ В ДЕЦИЛИ
# ============================================

def convert_to_deciles(df, country_name):
    """
    Преобразует данные в 10 децилей
    """
    if df is None or len(df) == 0:
        return None
    
    all_rows = []
    skipped_years = []
    
    for _, row in df.iterrows():
        year = int(row['year'])
        bottom_50 = float(row['bottom_50'])
        top_10 = float(row['top_10'])
        
        # Проверяем корректность данных
        if bottom_50 <= 0 or top_10 <= 0:
            skipped_years.append(year)
            continue
            
        # Вычисляем middle 40%
        middle_40 = 1 - bottom_50 - top_10
        
        # Если middle_40 отрицательный, нормализуем
        if middle_40 < -0.01:
            print(f"   ⚠️ {country_name} {year}: сумма {bottom_50+top_10:.3f} > 1, нормализую")
            total = bottom_50 + top_10
            bottom_50 = bottom_50 / total
            top_10 = top_10 / total
            middle_40 = 0
        elif middle_40 < 0:
            middle_40 = 0
        
        # Децили 1-5 (беднейшие 50%)
        decile_1_5 = bottom_50 / 5
        
        # Децили 6-9 (средние 40%)
        decile_6_9 = middle_40 / 4 if middle_40 > 0 else 0
        
        # Дециль 10 (богатейшие 10%)
        decile_10 = top_10
        
        # Проверка суммы децилей
        total = decile_1_5*5 + decile_6_9*4 + decile_10
        if abs(total - 1.0) > 0.01:
            print(f"   ⚠️ {country_name} {year}: сумма децилей {total:.3f}, нормализую")
            factor = 1.0 / total
            decile_1_5 *= factor
            decile_6_9 *= factor
            decile_10 *= factor
        
        # Создаём записи для каждого дециля
        for d in range(1, 11):
            if d <= 5:
                share = decile_1_5
            elif d <= 9:
                share = decile_6_9
            else:
                share = decile_10
            
            all_rows.append({
                'country': country_name,
                'year': year,
                'decile': d,
                'income_share': share
            })
    
    if skipped_years:
        print(f"   ⚠️ Пропущены годы с некорректными данными: {skipped_years[:5]}")
    
    return pd.DataFrame(all_rows)

