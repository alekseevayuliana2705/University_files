        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy.stats import pareto, poisson\n",
        "\n",
        "def insurance_simulation(T, lambda_claims, W0, c, k, sigma):\n",
        "    # Генерация страховых случаев\n",
        "    n_claims = poisson.rvs(lambda_claims * T)\n",
        "    claim_times = np.sort(np.random.uniform(0, T, n_claims))\n",
        "    claim_sizes = sigma * np.random.pareto(k, n_claims)\n",
        "\n",
        "    # Вычисление капитала во времени\n",
        "    t = np.linspace(0, T, 500)\n",
        "    capital = np.zeros_like(t)\n",
        "    for i, time in enumerate(t):\n",
        "        claims_up_to_t = claim_sizes[claim_times <= time].sum()\n",
        "        capital[i] = W0 + c * time - claims_up_to_t\n",
        "        if capital[i] < 0:\n",
        "            capital[i] = 0\n",
        "            break\n",
        "    return t, capital, claim_times, claim_sizes\n",
        "\n",
        "# Параметры моделирования\n",
        "T = 50\n",
        "lambda_claims = 1.25\n",
        "W0 = 50\n",
        "c = 2\n",
        "k = 2.5\n",
        "sigma = 1.25\n",
        "\n",
        "# Запуск симуляции\n",
        "time, capital, claims_t, claims_s = insurance_simulation(T, lambda_claims, W0, c, k, sigma)\n",
        "\n",
