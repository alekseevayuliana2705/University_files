        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from time import time\n",
        "\n",
        "# Функция Розенброка\n",
        "def rosenbrock(x):\n",
        "    return (x[0] - 1)**2 + 100 * (x[1] - x[0]**2)**2\n",
        "\n",
        "def choose_neighbour(s_i, T_i, sigma):\n",
        "    pair = np.random.normal(0, 1, 2)\n",
        "    return s_i + np.sqrt(T_i) * sigma * pair\n",
        "\n",
        "def simulated_annealing(func, k, sigma, eps, s_0, T_0):\n",
        "    start = time()\n",
        "    iters = 0\n",
        "    T = T_0\n",
        "    s = s_0\n",
        "    f_s = func(s)\n",
        "\n",
        "    # Выполняем, пока температура выше порога\n",
        "    while T > eps:\n",
        "        iters += 1\n",
        "        # Генерация соседней точки\n",
        "        s_neig = choose_neighbour(s, T, sigma)\n",
        "        f_neig = func(s_neig)\n",
        "        delta = f_neig - f_s\n",
        "\n",
        "        # Критерий принятия решения\n",
        "        if delta > 0:\n",
        "            # Ухудшение - принимаем с вероятностью p\n",
        "            p = np.exp(-delta / T)\n",
        "            if np.random.rand() < p:\n",
        "                s = s_neig\n",
        "                f_s = f_neig\n",
        "        else:\n",
        "            # Улучшение - всегда принимаем\n",
