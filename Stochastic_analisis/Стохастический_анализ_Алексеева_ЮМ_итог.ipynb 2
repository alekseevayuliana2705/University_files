        "from scipy.stats import norm, cauchy\n",
        "\n",
        "def simulate_ou_process(n_steps, sigma, theta, x0, dt=0.01):\n",
        "    t = np.linspace(0, (n_steps-1)*dt, n_steps)\n",
        "    x = np.zeros(n_steps)\n",
        "    x[0] = x0\n",
        "\n",
        "    # Коэффициент затухания\n",
        "    a = np.exp(-theta * dt)\n",
        "    # Дисперсия шума\n",
        "    q = sigma * np.sqrt((1 - np.exp(-2 * theta * dt)) / (2 * theta))\n",
        "    for i in range(1, n_steps):\n",
        "        x[i] = a * x[i-1] + q * np.random.normal()\n",
        "    return t, x\n",
        "\n",
        "def kalman_filter_ou(observations, theta, sigma, noise_var, dt=0.01):\n",
        "    n = len(observations)\n",
        "    # Отфильтрованные значения\n",
        "    filtered = np.zeros(n)\n",
        "    # Дисперсия ошибки\n",
        "    error_var = np.zeros(n)\n",
        "\n",
        "    # Инициализация\n",
        "    filtered[0] = observations[0]\n",
        "    error_var[0] = noise_var\n",
        "\n",
        "    # Параметры дискретной модели\n",
        "    a = np.exp(-theta * dt) # Коэффициент перехода\n",
        "    q2 = sigma**2 * (1 - np.exp(-2 * theta * dt)) / (2 * theta) # Дисперсия процессного шума\n",
        "\n",
        "    for i in range(1, n):\n",
        "        # Шаг прогноза\n",
        "        x_pred = a * filtered[i-1]\n",
        "        p_pred = a**2 * error_var[i-1] + q2\n",
        "        # Шаг обновления\n",
        "        K = p_pred / (p_pred + noise_var) # Оптимальный коэффициент Калмана\n",
        "        filtered[i] = x_pred + K * (observations[i] - x_pred) # Коррекция оценки\n",
        "        error_var[i] = (1 - K) * p_pred\n",
        "    return filtered, error_var\n",
        "\n",
        "def robust_kalman_filter(observations, theta, sigma, noise_scale, dt=0.01, threshold=3.0):\n",
        "    n = len(observations)\n",
        "    filtered = np.zeros(n)\n",
        "    error_var = np.zeros(n)\n",
        "    filtered[0] = observations[0]\n",
        "    error_var[0] = noise_scale**2\n",
        "    # Параметры дискретной модели процесса\n",
        "    a = np.exp(-theta * dt)\n",
        "    q2 = sigma**2 * (1 - np.exp(-2 * theta * dt)) / (2 * theta)\n",
        "\n",
        "    for i in range(1, n):\n",
        "        # Шаг прогноза\n",
        "        x_pred = a * filtered[i-1]\n",
        "        p_pred = a**2 * error_var[i-1] + q2\n",
        "        # Невязка\n",
        "        residual = observations[i] - x_pred\n",
        "        std_residual = np.sqrt(p_pred + noise_scale**2) # СКО невязки\n",
        "\n",
        "        # Обнаружение и обработка выбросов\n",
        "        # Если невязка превышает threshold стандартных отклонений, ограничиваем её\n",
        "        if abs(residual) > threshold * std_residual:\n",
        "            residual = np.sign(residual) * threshold * std_residual\n",
        "        # Обновление оценки с ограниченной невязкой\n",
        "        K = p_pred / (p_pred + noise_scale**2)\n",
        "        filtered[i] = x_pred + K * residual\n",
        "        error_var[i] = (1 - K) * p_pred\n",
        "    return filtered, error_var\n",
        "\n",
        "# Параметры моделирования\n",
        "n_points = 2**12 + 1\n",
        "sigma_true = 2.25\n",
        "theta_true = 0.75\n",
        "x0_true = 1.5\n",
        "noise_std = 1.25\n",
        "\n",
        "# Генерация процесса Орнштейна-Уленбека\n",
        "time, true_process = simulate_ou_process(n_points, sigma_true, theta_true, x0_true)\n",
        "\n",
        "# Гауссовский шум\n",
        "gaussian_noise = np.random.normal(0, noise_std, n_points)\n",
        "gaussian_observations = true_process + gaussian_noise\n",
        "\n",
        "# Применение Калмановского фильтра\n",
        "filtered_gaussian, error_gaussian = kalman_filter_ou(\n",
        "    gaussian_observations, theta_true, sigma_true, noise_std**2\n",
        ")\n",
        "\n",
        "# Шум Коши\n",
        "cauchy_noise = cauchy.rvs(0, noise_std, n_points)\n",
        "cauchy_observations = true_process + cauchy_noise\n",
        "\n",
        "# Удаление экстремальных выбросов для визуализации\n",
        "upper_limit = np.percentile(cauchy_observations, 97.5)\n",
        "lower_limit = np.percentile(cauchy_observations, 2.5)\n",
        "valid_mask = (cauchy_observations >= lower_limit) & (cauchy_observations <= upper_limit)\n",
        "cauchy_obs_clean = cauchy_observations[valid_mask]\n",
        "true_process_clean = true_process[valid_mask]\n",
        "time_clean = time[valid_mask]\n",
        "\n",
        "# Применение Калмановского фильтра\n",
        "filtered_cauchy, error_cauchy = robust_kalman_filter(\n",
        "    cauchy_obs_clean, theta_true, sigma_true, noise_std\n",
        ")\n",
        "\n",
        "# Вычисление доверительных интервалов\n",
        "confidence_level = 0.95\n",
        "z_value = norm.ppf(1 - (1 - confidence_level) / 2)\n",
        "ci_lower_gaussian = filtered_gaussian - z_value * np.sqrt(error_gaussian)\n",
        "ci_upper_gaussian = filtered_gaussian + z_value * np.sqrt(error_gaussian)\n",
        "ci_lower_cauchy = filtered_cauchy - z_value * np.sqrt(error_cauchy)\n",
        "ci_upper_cauchy = filtered_cauchy + z_value * np.sqrt(error_cauchy)\n",
        "\n",
        "# Построение графиков результатов\n",
        "fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(12, 10))\n",
        "\n",
        "# Случай гауссовского шума\n",
        "ax1.grid(True, alpha=0.3)\n",
        "ax1.fill_between(time, ci_lower_gaussian, ci_upper_gaussian,\n",
        "                alpha=0.3, color='#1ddbf0', label='Confidence band')\n",
        "ax1.plot(time, gaussian_observations, '.', markersize=1, alpha=0.5,\n",
        "        color='blue', label='Noisy observations')\n",
        "ax1.plot(time, true_process, 'blue', linewidth=1.5, label='True process')\n",
        "ax1.plot(time, filtered_gaussian, '#5E5491', linewidth=1.5, label='Kalman estimate')\n",
        "ax1.set_title('Ornstein-Uhlenbeck Process with Gaussian Noise')\n",
        "ax1.set_ylabel('X(t)')\n",
        "ax1.legend()\n",
        "\n",
        "# Случай шума Коши\n",
        "ax2.grid(True, alpha=0.3)\n",
        "ax2.fill_between(time_clean, ci_lower_cauchy, ci_upper_cauchy,\n",
        "                alpha=0.3, color='#1ddbf0', label='Confidence band')\n",
        "ax2.plot(time_clean, cauchy_obs_clean, '.', markersize=1, alpha=0.5,\n",
        "        color='blue', label='Noisy observations (cleaned)')\n",
        "ax2.plot(time_clean, true_process_clean, 'blue', linewidth=1.5, label='True process')\n",
        "ax2.plot(time_clean, filtered_cauchy, '#5E5491', linewidth=1.5, label='Robust estimate')\n",
        "ax2.set_title('Ornstein-Uhlenbeck Process with Cauchy Noise')\n",
        "ax2.set_xlabel('Time')\n",
        "ax2.set_ylabel('X(t)')\n",
        "ax2.legend()\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# Метрики производительности\n",
        "mse_gaussian = np.mean((filtered_gaussian - true_process)**2)\n",
