        "def generate_cyclic_queuing(T, base_intensity, n_points=1000):\n",
        "    # Интенсивность\n",
        "    major_intensity = 2 * base_intensity\n",
        "\n",
        "    # Генерация однородного пуассоновского процесса\n",
        "    n_events = poisson.rvs(major_intensity * T)\n",
        "    candidate_times = np.sort(np.random.uniform(0, T, n_events))\n",
        "\n",
        "    # Принимаем события с вероятностью (1 + cos(t))/2\n",
        "    acceptance_probs = (1 + np.cos(candidate_times)) / 2\n",
        "    accepted = bernoulli.rvs(acceptance_probs)\n",
        "    event_times = candidate_times[accepted == 1]\n",
        "    time_grid = np.linspace(0, T, n_points)\n",
        "    process_count = np.zeros(n_points)\n",
        "\n",
        "    for i, t in enumerate(time_grid):\n",
        "        process_count[i] = np.sum(event_times <= t)\n",
        "\n",
        "    return time_grid, process_count, event_times\n",
